PORT=8080
# Protege exportação de leads e reset do ranking: /api/leads.csv?token=...
ADMIN_TOKEN=

# --- Integração NECSO Atende (Empresa → Canais → adicionar canal tipo API; o secret aparece uma vez) ---
NECSO_CLIENT_ID=
NECSO_CLIENT_SECRET=
# Funil do CRM onde o lead entra (busca pelo nome; padrão "Comercial") e etapa (padrão: a primeira)
NECSO_FUNNEL_NAME=Comercial
NECSO_CRM_STAGE_ID=
# 1 = além do card, abre ticket e dispara o chatbot do canal
NECSO_OPEN_TICKET=0

# --- Alternativa: webhook genérico (usado só se as credenciais NECSO estiverem vazias) ---
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
